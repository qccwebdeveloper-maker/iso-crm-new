# Google service account keys (never commit — Drive API access credentials)
backend/secrets/
*service-account*.json

# Bulk-generated client login credentials (never commit)
backend/scripts/old-client-logins.csv
backend/scripts/deleted-old-clients-above-*.json

# Full-DB backups (real client PII + password hashes — never commit)
backend/backups/

